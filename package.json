{
  "name": "@utexo/rgb-sdk-web",
  "version": "1.0.0",
  "description": "RGB_L1 wallet engine for browsers: @utexo/rgb-lib-wasm behind the @utexo/rgb-sdk-core SharedWalletApi contract",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.17.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@utexo/rgb-sdk": "file:../.local-packages/utexo-rgb-sdk-2.0.0-alpha.0.tgz",
    "@utexo/rgb-sdk-core": "file:../.local-packages/utexo-rgb-sdk-core-0.1.0.tgz",
    "esbuild": "0.27.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "type": "module",
  "scripts": {
    "prettier": "prettier --write \"**/*.{js,mjs,ts,tsx}\"",
    "lint": "eslint \"**/*.{js,mjs,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -w",
    "build": "tsup",
    "test:unit": "npm run build && node --test --experimental-test-module-mocks tests/unit/*.test.mjs",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run typecheck:examples",
    "test:e2e": "npm run build && playwright test -c tests/e2e/playwright.config.mjs",
    "version:patch": "npm version patch && git push && git push --tags && npm publish --access public",
    "version:minor": "npm version minor && git push && git push --tags && npm publish --access public",
    "version:major": "npm version major && git push && git push --tags && npm publish --access public",
    "typecheck:examples": "tsc -p examples/tsconfig.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@utexo/rgb-lib-wasm": "1.0.0-beta.4"
  },
  "peerDependencies": {
    "@utexo/rgb-sdk-core": "^0.1.0"
  },
  "keywords": [
    "rgb",
    "rgb-protocol",
    "bitcoin",
    "sdk",
    "wasm",
    "taproot",
    "assets",
    "blockchain"
  ],
  "license": "MIT",
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
